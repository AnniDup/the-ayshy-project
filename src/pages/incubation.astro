---
// src/pages/incubation.astro
import Layout from '@layouts/Layout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// 1. Fetch all projects from your collection
const allProjects = await getCollection('projects');

// 2. Filter strictly for your "idea" statuses
const incubationProjects = allProjects.filter(project => project.data.status === 'idea');

// 3. Optional: Sort them newest to oldest if you have dates, or alphabetically
incubationProjects.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Incubation Chamber">
  <main class="incubation-dashboard">
    <header class="dashboard-header">
      <h1>Incubation Chamber</h1>
      <p>Raw concepts, prototypes, and neural impulses awaiting execution.</p>
    </header>

    <div class="project-grid">
      {incubationProjects.length > 0 ? (
        incubationProjects.map(project => {
          // Compute the link based on how your workshop items are routed
          const slug = project.id.replace(/\/index$/, '');
          const projectLink = `/workshop/${slug}`;

          return (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              link={projectLink}
              image={project.data.image}
              tags={project.data.tags}
              status={project.data.status}
            />
          );
        })
      ) : (
        <p class="empty-state">The chamber is empty. No inactive ideas found in the database.</p>
      )}
    </div>
  </main>
</Layout>

<style>
  /* Basic grid structure layout without any superficial styling blocks */
  .incubation-dashboard {
    padding: 2rem;
  }
  .dashboard-header {
    margin-bottom: 2rem;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .empty-state {
    color: var(--text-muted);
    font-style: italic;
  }
</style>