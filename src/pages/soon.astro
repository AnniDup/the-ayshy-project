---
// src/pages/soon.astro
// The site-wide placeholder page. Deliberately kept as the default landing
// for any project or section that doesn't have content yet.
// Do not delete this page — it is wired as the fallback for isDraft entries.
import Layout from '@layouts/Layout.astro';
---

<Layout title="Soon" description="This section is still being assembled.">
  <div class="status-container">
    <div class="status-card">

      <div class="status-header">
        <span class="status-badge">Compiling workspace...</span>
        <span class="system-id">backlog_overflow.sh</span>
      </div>

      <div class="status-body">
        <h1>Under construction</h1>

        <p class="status-text">
          This project currently exists as a high-priority neural impulse, a half-empty folder,
          and a dream.
        </p>

        <p class="status-text">
          Look, there are roughly 47 active side projects, exactly 24 hours in a day,
          and rumor has it there is an entire world outside with "grass" that needs touching.
          The math simply isn't mathing right now.
        </p>

        <blockquote class="status-quote">
          "The code is compilation-ready, but the human runtime environment requires sleep and sustenance."
        </blockquote>

        <div class="navigation-box">
          <p>Execution paused. Redirect recommended:</p>
          <a href="/" class="return-link">← Return to Main Dashboard</a>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .status-container {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 70vh;
    padding: 1rem;
    width: 100%;
  }

  .status-card {
    display: block;
    width: 100%;
    max-width: 650px;
    background: var(--bg-surface);
    border: 1px solid var(--hairline);
    border-radius: 4px;
  }

  .status-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--bg-elevated);
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--green-bright);
    letter-spacing: 0.04em;
  }

  .system-id {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .status-body {
    padding: 2.5rem 2rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0 0 1.5rem 0;
    color: var(--bone);
  }

  .status-text {
    line-height: 1.7;
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .status-quote {
    margin: 2rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 2px solid var(--green-mid);
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.9rem;
    background: rgba(143,191,92,0.04);
  }

  .navigation-box {
    margin-top: 2.5rem;
    font-size: 0.88rem;
    color: var(--text-faint);
    border-top: 1px dashed var(--hairline);
    padding-top: 1.5rem;
  }

  .navigation-box p { margin: 0 0 0.5rem 0; }

  .return-link {
    display: inline-block;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--green-bright);
    letter-spacing: 0.02em;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .return-link:hover {
    opacity: 0.8;
    transform: translateX(-3px);
  }
</style>
