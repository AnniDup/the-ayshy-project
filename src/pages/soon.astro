---
// src/pages/soon.astro
import Layout from '@layouts/Layout.astro';
---

<Layout>
  <div class="maintenance-container">
    <div class="terminal-window">
      <div class="terminal-header">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="title">backlog_overflow.sh</span>
      </div>
      
      <div class="terminal-body">
        <p class="error-line">⚠️ WARNING: STACK OVERFLOW DETECTED</p>
        <hr class="terminal-divider" />
        
        <h1>[CONTENT_COMING_SOON]</h1>
        
        <p class="joke-text">
          This project currently exists as a high-priority neural impulse, a half-empty folder, 
          and a dream. 
        </p>
        
        <p class="joke-text">
          Look, there are roughly 47 active side projects, exactly 24 hours in a day, 
          and rumor has it there is an entire world outside with "grass" that needs touching. 
          The math simply isn't mathing right now.
        </p>

        <blockquote class="status-quote">
          "The code is compilation-ready, but the human runtime environment requires sleep and sustenance."
        </blockquote>

        <div class="navigation-box">
          <p>Execution halted. Redirect recommended:</p>
          <a href="/" class="return-link">&lt;-- Return to Main Dashboard</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Local styles are kept strictly structural to map to your layout dimensions */
  .maintenance-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    padding: 1rem;
  }

  .terminal-window {
    width: 100%;
    max-width: 650px;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    padding: 0.5rem 1rem;
    gap: 0.5rem;
  }

  .terminal-header .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-header .title {
    margin-left: auto;
    margin-right: auto;
    font-family: monospace;
    font-size: 0.8rem;
  }

  .terminal-body {
    padding: 2rem;
    font-family: monospace;
  }

  h1 {
    font-size: 1.8rem;
    margin: 1rem 0;
    text-transform: uppercase;
  }

  .terminal-divider {
    border: 0;
    height: 1px;
    margin: 1.5rem 0;
  }

  .joke-text {
    line-height: 1.6;
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
  }

  .status-quote {
    margin: 2rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid;
    font-style: italic;
    font-size: 0.9rem;
  }

  .navigation-box {
    margin-top: 2.5rem;
    font-size: 0.9rem;
  }

  .return-link {
    display: inline-block;
    margin-top: 0.5rem;
    text-decoration: none;
    font-weight: bold;
    border-bottom: 1px dashed;
    transition: color 0.2s;
  }
</style>