---
// src/pages/soon.astro
import Layout from '@layouts/Layout.astro';
---

<Layout>
  <div class="status-container">
    <div class="status-card">
      <div class="status-header">
        <span class="status-badge">Compiling workspace...</span>
        <span class="system-id">backlog_overflow.sh</span>
      </div>
      
      <div class="status-body">
        <h1>Under construction</h1>
        
        <p class="status-text">
          This project currently exists as a high-priority neural impulse, a half-empty folder, 
          and a dream. 
        </p>
        
        <p class="status-text">
          Look, there are roughly 47 active side projects, exactly 24 hours in a day, 
          and rumor has it there is an entire world outside with "grass" that needs touching. 
          The math simply isn't mathing right now.
        </p>

        <blockquote class="status-quote">
          "The code is compilation-ready, but the human runtime environment requires sleep and sustenance."
        </blockquote>

        <div class="navigation-box">
          <p>Execution paused. Redirect recommended:</p>
          <a href="/" class="return-link">Return to Main Dashboard</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .status-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
    padding: 1rem;
    box-sizing: border-box;
    /* FIX: Ensures parent grids don't stretch the container track out of the viewport bounds */
    width: 100%;
  }

  .status-card {
    /* FIX: Force block layout to guarantee max-width calculation locks at 650px maximum */
    display: block;
    width: 100%;
    max-width: 650px;
    background-color: var(--surface-color);
    border: 1px solid var(--accent-sand);
    border-radius: 6px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .status-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--accent-sand);
    background-color: rgba(0, 0, 0, 0.1);
  }

  .status-badge {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent-green);
    /* FIX: Breaks inheritance loops causing text transformation bugs */
    text-transform: none !important;
  }

  .system-id {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .status-body {
    padding: 2.5rem 2rem;
  }

  h1 {
    font-size: 1.8rem;
    margin: 0 0 1.5rem 0;
    color: var(--text-main);
    font-weight: 600;
    letter-spacing: -0.02em;
    /* FIX: Re-enforces normal typography case styling completely */
    text-transform: none !important;
  }

  .status-text {
    line-height: 1.6;
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
    color: var(--text-main);
    text-transform: none !important;
  }

  .status-quote {
    margin: 2rem 0;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--accent-green);
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.9rem;
    background-color: rgba(0, 0, 0, 0.05);
    text-transform: none !important;
  }

  .navigation-box {
    margin-top: 2.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    border-top: 1px dashed var(--accent-sand);
    padding-top: 1.5rem;
  }

  .return-link {
    display: inline-block;
    margin-top: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    color: var(--accent-green);
    transition: transform 0.2s, color 0.2s;
  }
  
  .return-link:hover {
    color: var(--text-main);
    transform: translateX(4px);
  }
</style>