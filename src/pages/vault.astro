---
import Layout from '@layouts/Layout.astro';
---
<Layout title="Vault" description="Interactive tools, when they exist.">
  <h1 class="page-title">Vault</h1>
  <p class="page-sub">// reserved for interactive tools and utilities</p>
  <div class="panel-card empty-panel">
    <p class="empty-state">Nothing built yet. This is where standalone interactive tools will live once they exist, separate from the project writeups in the Workshop.</p>
  </div>
</Layout>

<style>
  .page-title { font-size: 1.7rem; margin-bottom: 0.3rem; }
  .page-sub { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.82rem; margin: 0 0 2rem 0; }
  .empty-panel { padding: 2rem; max-width: 560px; }
</style>
