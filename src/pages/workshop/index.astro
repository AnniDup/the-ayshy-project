---
// src/pages/workshop/index.astro — the active project board
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import FilterToolbar from '@components/FilterToolbar.astro';
import { projectLink } from '@lib/utils';

const allProjects = await getCollection('projects');

// Ideas live in Incubation, not here.
const activeProjects = allProjects.filter(p => p.data.status !== 'idea');
const inProgress = activeProjects.filter(p => p.data.status === 'in-progress');
const completed = activeProjects.filter(p => p.data.status === 'completed');

const allTags = Array.from(new Set(activeProjects.flatMap(p => p.data.tags || []))).sort();
const statuses = Array.from(new Set(activeProjects.map(p => p.data.status).filter(Boolean)));

---

<Layout title="Workshop" description="The active project board.">
  <h1 class="page-title">Project Horizon</h1>
  <p class="page-sub">// {activeProjects.length} active or completed entries</p>

  <FilterToolbar statuses={statuses} tags={allTags} />

  <div class="pipeline-sections">
    <details class="pipeline-section" open>
      <summary class="section-header">
        <span class="section-title">In Progress ({inProgress.length})</span>
        <span class="section-arrow"></span>
      </summary>
      <div class="section-content">
        {inProgress.length > 0 ? (
          <div class="project-grid">
            {inProgress.map(p => (
              <div class="card-wrapper" data-tags={(p.data.tags || []).join(',')}>
                <ProjectCard {...p.data} link={projectLink(p)} />
              </div>
            ))}
          </div>
        ) : <p class="empty-state">Nothing in progress right now.</p>}
      </div>
    </details>

    <details class="pipeline-section" open>
      <summary class="section-header">
        <span class="section-title">Completed ({completed.length})</span>
        <span class="section-arrow"></span>
      </summary>
      <div class="section-content">
        {completed.length > 0 ? (
          <div class="project-grid">
            {completed.map(p => (
              <div class="card-wrapper" data-tags={(p.data.tags || []).join(',')}>
                <ProjectCard {...p.data} link={projectLink(p)} />
              </div>
            ))}
          </div>
        ) : <p class="empty-state">Nothing completed yet.</p>}
      </div>
    </details>
  </div>
</Layout>

<style>
  .page-title { font-size: 1.7rem; margin-bottom: 0.3rem; }
  .page-sub { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.82rem; margin: 0 0 2rem 0; }

  .pipeline-sections { display: flex; flex-direction: column; gap: 1.5rem; width: 100%; }

  .pipeline-section {
    background: var(--bg-surface);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    overflow: hidden;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--bg-elevated);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .section-header::-webkit-details-marker { display: none; }

  .section-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--bone);
  }

  .section-arrow {
    width: 8px; height: 8px;
    border-right: 2px solid var(--text-muted);
    border-bottom: 2px solid var(--text-muted);
    transform: rotate(45deg);
    transition: transform 0.2s;
  }
  .pipeline-section[open] .section-arrow { transform: rotate(-135deg); }

  .section-content { padding: 1.5rem; border-top: 1px solid var(--hairline); }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.1rem;
    width: 100%;
  }

  .card-wrapper { transition: opacity 0.2s ease; }
</style>

<script>
  const filterButtons = document.querySelectorAll('.status-btn, .tag-btn');
  const cardWrappers = document.querySelectorAll('.card-wrapper');

  let activeStatus = 'all';
  let activeTag = 'all';

  function applyFilters() {
    cardWrappers.forEach(wrapper => {
      const card = wrapper.querySelector('[data-project-status]');
      const cardStatus = card?.getAttribute('data-project-status');
      const rawTags = wrapper.getAttribute('data-tags');
      const cardTags = rawTags ? rawTags.split(',') : [];

      const matchesStatus = activeStatus === 'all' || cardStatus === activeStatus;
      const matchesTag = activeTag === 'all' || cardTags.includes(activeTag);

      (wrapper as HTMLElement).style.display = (matchesStatus && matchesTag) ? '' : 'none';
    });
  }

  document.querySelectorAll('.status-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.status-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatus = btn.getAttribute('data-status-filter') || 'all';
      applyFilters();
    });
  });

  document.querySelectorAll('.tag-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tag-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTag = btn.getAttribute('data-tag-filter') || 'all';
      applyFilters();
    });
  });
</script>
