---
// src/pages/workshop/index.astro
// Shows all projects. Filterable by domain, status, and tag.
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { projectLink } from '@lib/utils';
import { DOMAINS } from '@lib/taxonomy';

const allProjects = await getCollection('projects');
const allTags = Array.from(new Set(allProjects.flatMap(p => p.data.tags || []))).sort();
const statuses = ['active', 'resting', 'shelved', 'idea'];
---

<Layout title="Workshop" description="All projects across all domains.">
  <h1 class="page-title">Workshop</h1>
  <p class="page-sub">// {allProjects.length} {allProjects.length === 1 ? 'project' : 'projects'} across {DOMAINS.length} domains</p>

  <div class="filter-bar">
    <div class="filter-row">
      <span class="filter-label">Domain</span>
      <button class="filter-btn domain-btn active" data-domain="all">All</button>
      {DOMAINS.map(d => (
        <button class="filter-btn domain-btn" data-domain={d.slug}>{d.label}</button>
      ))}
    </div>
    <div class="filter-row">
      <span class="filter-label">Status</span>
      <button class="filter-btn status-btn active" data-status="all">All</button>
      {statuses.map(s => (
        <button class="filter-btn status-btn" data-status={s}>{s}</button>
      ))}
    </div>
    <div class="filter-row">
      <span class="filter-label">Tag</span>
      <button class="filter-btn tag-btn active" data-tag="all">All</button>
      {allTags.map(t => (
        <button class="filter-btn tag-btn" data-tag={t}>{t}</button>
      ))}
    </div>
  </div>

  <div class="project-grid">
    {allProjects.map(p => (
      <div
        class="card-wrapper"
        data-domains={(p.data.domains || []).join(',')}
        data-status={(p.data.status || '').toLowerCase()}
        data-tags={(p.data.tags || []).join(',')}
      >
        <ProjectCard
          title={p.data.title}
          description={p.data.description}
          link={projectLink(p)}
          image={p.data.image}
          tags={p.data.tags || []}
          status={p.data.status}
          domains={p.data.domains || []}
        />
      </div>
    ))}
  </div>

  <p class="no-results" style="display:none">No projects match the current filters.</p>
</Layout>

<style>
  .page-title { font-size: 1.7rem; margin-bottom: 0.3rem; }
  .page-sub { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.82rem; margin: 0 0 2rem 0; }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--hairline);
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--text-faint);
    min-width: 55px;
    letter-spacing: 0.04em;
  }
  .filter-btn {
    background: transparent;
    border: 1px solid var(--hairline);
    color: var(--text-muted);
    padding: 0.25rem 0.7rem;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.15s ease;
    text-transform: capitalize;
  }
  .domain-btn:hover, .domain-btn.active { border-color: var(--green-bright); color: var(--green-bright); background: rgba(143,191,92,0.08); }
  .status-btn:hover, .status-btn.active { border-color: var(--gold); color: var(--gold); background: rgba(217,164,65,0.08); }
  .tag-btn:hover, .tag-btn.active       { border-color: var(--reserved-sky); color: var(--reserved-sky); background: rgba(79,163,168,0.08); }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .card-wrapper { transition: opacity 0.15s ease; }
  .no-results { color: var(--text-muted); font-style: italic; margin-top: 2rem; }
</style>

<script>
  let activeFilters = { domain: 'all', status: 'all', tag: 'all' };

  function applyFilters() {
    const wrappers = document.querySelectorAll<HTMLElement>('.card-wrapper');
    let visible = 0;

    wrappers.forEach(el => {
      const domains = (el.dataset.domains ?? '').split(',').filter(Boolean);
      const status  = el.dataset.status ?? '';
      const tags    = (el.dataset.tags ?? '').split(',').filter(Boolean);

      const matchDomain = activeFilters.domain === 'all' || domains.includes(activeFilters.domain);
      const matchStatus = activeFilters.status === 'all' || status === activeFilters.status;
      const matchTag    = activeFilters.tag === 'all'    || tags.includes(activeFilters.tag);

      const show = matchDomain && matchStatus && matchTag;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    const noResults = document.querySelector<HTMLElement>('.no-results');
    if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
  }

  function wireButtons(selector: string, key: keyof typeof activeFilters, dataAttr: string) {
    document.querySelectorAll(selector).forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll(selector).forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeFilters[key] = (btn as HTMLElement).dataset[dataAttr] || 'all';
        applyFilters();
      });
    });
  }

  wireButtons('.domain-btn', 'domain', 'domain');
  wireButtons('.status-btn', 'status', 'status');
  wireButtons('.tag-btn',    'tag',    'tag');
</script>
