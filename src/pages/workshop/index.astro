---
// src/pages/workshop/index.astro
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import ProjectCard from '@components/ProjectCard.astro';

const allProjects = await getCollection('projects');

// Group projects by their pipeline status
const ideas = allProjects.filter(p => p.data.status === 'idea');
const inProgress = allProjects.filter(p => p.data.status === 'in-progress');
const completed = allProjects.filter(p => p.data.status === 'completed');
---

<Layout title="Project Command Center">
  <h1>Project Pipeline ({allProjects.length} Total)</h1>

  <div class="pipeline-board">
    <div class="column">
      <h2>💡 Ideas ({ideas.length})</h2>
      <div class="column-feed">
        {ideas.map(p => <ProjectCard {...p.data} link={`/workshop/${p.id.replace(/\/index$/, '')}`} />)}
      </div>
    </div>

    <div class="column">
      <h2>🚧 In Progress ({inProgress.length})</h2>
      <div class="column-feed">
        {inProgress.map(p => <ProjectCard {...p.data} link={`/workshop/${p.id.replace(/\/index$/, '')}`} />)}
      </div>
    </div>

    <div class="column">
      <h2>✅ Completed ({completed.length})</h2>
      <div class="column-feed">
        {completed.map(p => <ProjectCard {...p.data} link={`/workshop/${p.id.replace(/\/index$/, '')}`} />)}
      </div>
    </div>
  </div>
</Layout>

<style>
  .pipeline-board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .column {
    background: var(--surface-light);
    padding: 1.5rem;
    border-radius: 6px;
    border: 1px solid var(--border-color);
  }
  .column h2 {
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--accent-sand);
    padding-bottom: 0.5rem;
  }
  .column-feed {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>