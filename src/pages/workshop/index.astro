---
// src/pages/workshop/index.astro
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import FilterToolbar from '@components/FilterToolbar.astro';

const allProjects = await getCollection('projects');

// 1. Filter out raw ideas (which live in incubation)
const activeProjects = allProjects.filter(p => p.data.status !== 'idea');

const inProgress = activeProjects.filter(p => p.data.status === 'in-progress');
const completed = activeProjects.filter(p => p.data.status === 'completed');
const idea = activeProjects.filter(p => p.data.status === 'idea');

const allTags = Array.from(
  new Set(activeProjects.flatMap(p => p.data.tags || []))
).sort();

const statuses = Array.from(
  new Set(activeProjects.map(p => p.data.status).filter(Boolean))
);
---

<Layout title="Project Command Center">
  <h1 class="page-title">Project Horizon</h1>

  <FilterToolbar statuses={statuses} tags={allTags} />

  <div class="pipeline-sections">
    <!-- Section 1: In Progress -->
    <details class="pipeline-section" open>
      <summary class="section-header">
        <span class="section-title">In Progress ({inProgress.length})</span>
        <span class="section-arrow"></span>
      </summary>
      <div class="section-content">
        <div class="project-grid">
          {inProgress.map(p => (
            <div class="card-wrapper" data-tags={(p.data.tags || []).join(',')}>
              <ProjectCard {...p.data} link="/soon" />
            </div>
          ))}
        </div>
      </div>
    </details>

    <!-- Section 2: Completed -->
    <details class="pipeline-section" open>
      <summary class="section-header">
        <span class="section-title">Completed ({completed.length})</span>
        <span class="section-arrow"></span>
      </summary>
      <div class="section-content">
        <div class="project-grid">
          {completed.map(p => (
            <div class="card-wrapper" data-tags={(p.data.tags || []).join(',')}>
              <ProjectCard {...p.data} link="/soon" />
            </div>
          ))}
        </div>
      </div>
    </details>

        <!-- Section 3: Ideas -->
    <details class="pipeline-section" open>
      <summary class="section-header">
        <span class="section-title">Ideas ({idea.length})</span>
        <span class="section-arrow"></span>
      </summary>
      <div class="section-content">
        <div class="project-grid">
          {idea.map(p => (
            <div class="card-wrapper" data-tags={(p.data.tags || []).join(',')}>
              <ProjectCard {...p.data} link="/soon" />
            </div>
          ))}
        </div>
      </div>
    </details>
  </div>
</Layout>

<script>
  // Simple, vanilla JavaScript filter engine
  const filterButtons = document.querySelectorAll('.filter-btn');
  const cardWrappers = document.querySelectorAll('.card-wrapper');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle button active visuals
      filterButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const activeFilter = btn.getAttribute('data-filter');
      if (!activeFilter) return; // Guard against null filters

      cardWrappers.forEach(wrapper => {
        const rawTags = wrapper.getAttribute('data-tags');
        // Fix: Fallback to an empty string array if data-tags is null
        const cardTags = rawTags ? rawTags.split(',') : [];
        
        if (activeFilter === 'all' || cardTags.includes(activeFilter)) {
          (wrapper as HTMLElement).style.display = 'block';
        } else {
          (wrapper as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .page-title {
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  /* Tag Filter Toolbar Styles */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px dashed var(--accent-sand);
    padding-bottom: 1.25rem;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--accent-sand);
    color: var(--text-muted);
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-btn:hover, .filter-btn.active {
    background: var(--surface-color);
    border-color: var(--accent-green);
    color: var(--accent-green);
  }

  /* Collapsible Layout Blueprint */
  .pipeline-sections {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .pipeline-section {
    background: var(--surface-color);
    border: 1px solid var(--accent-sand);
    border-radius: 6px;
    overflow: hidden;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background-color: rgba(0, 0, 0, 0.1);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .section-header::-webkit-details-marker {
    display: none;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-main);
  }

  /* Clean Custom Accordion Arrow Indicator */
  .section-arrow {
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--text-muted);
    border-bottom: 2px solid var(--text-muted);
    transform: rotate(45deg);
    transition: transform 0.2s;
  }

  .pipeline-section[open] .section-arrow {
    transform: rotate(-135deg);
  }

  .section-content {
    padding: 1.5rem;
    border-top: 1px solid var(--accent-sand);
  }

  /* Your grid layouts open up full-width now */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .card-wrapper {
    transition: opacity 0.2s ease;
  }
</style>