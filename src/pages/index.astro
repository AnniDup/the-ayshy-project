---
// src/pages/index.astro — garden overview, not a duplicate of /workshop
import { getCollection } from 'astro:content';
import ProjectCard from '@components/ProjectCard.astro';
import Layout from '@layouts/Layout.astro';
import { projectLink } from '@lib/utils';

const allProjects = await getCollection('projects');
const active = allProjects.filter(p => p.data.status !== 'idea');

// "Recent" — sorted by date where present, most recent first, capped to a handful
const recent = [...active]
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 4);

const domainCount = new Set(allProjects.map(p => p.id.split('/')[0])).size;
---

<Layout title="Landing" description="The AyShy Project — a digital garden of projects, notes, and experiments.">
  <header class="hero">
    <p class="eyebrow">// digital garden</p>
    <h1 class="hero-title">The AyShy Project</h1>
    <p class="hero-sub">
      A growing collection of builds, worlds, and half-finished ideas —
      tracked across {domainCount} domains, {active.length} active or completed, and
      whatever's still incubating.
    </p>
  </header>

  <nav class="entry-points">
    <a href="/workshop" class="entry-card">
      <span class="entry-label">Workshop</span>
      <span class="entry-desc">The full project board — in progress, completed, filterable.</span>
    </a>
    <a href="/incubation" class="entry-card">
      <span class="entry-label">Incubation</span>
      <span class="entry-desc">Raw ideas not yet promoted to active work.</span>
    </a>
    <a href="/notebook" class="entry-card">
      <span class="entry-label">Notebook</span>
      <span class="entry-desc">Loose notes, not tied to a single project.</span>
    </a>
    <a href="/vault" class="entry-card">
      <span class="entry-label">Vault</span>
      <span class="entry-desc">Interactive tools, when they exist.</span>
    </a>
  </nav>

  {recent.length > 0 && (
    <section>
      <div class="section-header">Recently Touched<span class="section-rule"></span></div>
      <div class="grid">
        {recent.map((project, i) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            link={projectLink(project)}
            image={project.data.image}
            tags={project.data.tags || []}
            status={project.data.status}
            featured={i === 0}
          />
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .hero { margin-bottom: 2.5rem; max-width: 640px; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--green-bright);
    margin: 0 0 0.5rem 0;
  }
  .hero-title { font-size: 2.1rem; margin: 0 0 0.75rem 0; }
  .hero-sub { color: var(--text-muted); margin: 0; }

  .entry-points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .entry-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.2rem;
    background: var(--bg-surface);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    text-decoration: none;
    color: var(--bone);
    transition: border-color 0.15s ease;
  }
  .entry-card:hover { border-color: var(--green-mid); opacity: 1; }
  .entry-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--green-bright);
  }
  .entry-desc { font-size: 0.82rem; color: var(--text-muted); }

  .section-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.1rem 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .section-rule { flex: 1; height: 1px; background: var(--hairline); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.1rem;
  }
</style>
