---
// src/pages/index.astro
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectCard from '@components/ProjectCard.astro';
import Layout from '@layouts/Layout.astro';
import FilterToolbar from '@components/FilterToolbar.astro';

// Fetch the projects collection
const allProjects = (await getCollection('projects')) as CollectionEntry<'projects'>[];

// FIX for lines 11 & 15: Type 'p' so TypeScript can safely read 'p.data'
const allTags = Array.from(
  new Set(allProjects.flatMap((p: CollectionEntry<'projects'>) => p.data.tags || []))
).sort();

const allStatuses = Array.from(
  new Set(allProjects.map((p: CollectionEntry<'projects'>) => p.data.statusProject.toLowerCase()))
).sort();
---

<Layout>
  <h1>Dashboard</h1>

  <FilterToolbar statuses={allStatuses} tags={allTags} />
  
  <div class="grid">
    {allProjects.map((project: CollectionEntry<'projects'>) => (

        <ProjectCard 
          title={project.data.title}
          description={project.data.description}
          link={`/workshop/${project.id.replace(/\/index$/, '')}`}
          image={project.data.image}
          tags={project.data.tags || []}
          status={project.data.statusProject}
        />
    ))}
  </div>
</Layout>

<style>
  h1 { margin-bottom: 2rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 450px));
    gap: 1.5rem;
    padding: 1rem 0;
  }
</style>