---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /> 
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Ayshy Project</title>
  </head>
  <body>
  <body>
    <div class="app-container">
      <Sidebar />
      <main class="content">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .app-container {
    display: grid;
    /* FIX: Starts at 260px but auto-grows to match the content width if nesting expands, safely pushing the 1fr content track over */
    grid-template-columns: minmax(260px, max-content) 1fr;
    min-height: 100vh;
    width: 100%;
  }

  .content { 
    padding: 2rem; 
    /* FIX: Prevents child components (like grids/cards) from bursting column calculations */
    min-width: 0; 
    overflow-x: hidden;
  }
</style>