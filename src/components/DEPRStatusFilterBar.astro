---
// src/components/StatusFilterBar.astro

interface Props {
  statuses: string[];
}

const { statuses } = Astro.props;
---

<div class="status-bar">
  <button class="status-btn active" data-status-filter="all">All Statuses</button>
  {statuses.map(status => (
    <button class="status-btn" data-status-filter={status}>
      {status.replace('-', ' ')}
    </button>
  ))}
</div>

<script>
  const statusButtons = document.querySelectorAll('.status-btn');
  const cards = document.querySelectorAll('[data-tags]');

  statusButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      statusButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const activeStatus = btn.getAttribute('data-status-filter');
      if (!activeStatus) return;

      cards.forEach(card => {
        // Read directly from the dynamic attribute we added to the card
        const cardStatus = card.getAttribute('data-project-status');
        
        if (activeStatus === 'all' || cardStatus === activeStatus) {
          card.classList.remove('is-status-hidden');
        } else {
          card.classList.add('is-status-hidden');
        }
      });
    });
  });
</script>

<style>
  .status-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .status-btn {
    background: transparent;
    border: 1px solid var(--accent-sand);
    color: var(--text-muted);
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .status-btn:hover, .status-btn.active {
    background: var(--surface-color);
    border-color: var(--accent-blue, #3b82f6);
    color: var(--accent-blue, #3b82f6);
  }

  :global(.is-status-hidden) {
    display: none !important;
  }
</style>