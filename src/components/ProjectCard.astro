---
// src/components/ProjectCard.astro
import { Image } from 'astro:assets';
import { getTagColorClass } from '@lib/taxonomy';

interface Props {
  title: string;
  description: string;
  link: string;
  image: ImageMetadata;
  tags: string[];
  status: string;
  featured?: boolean;
}

const { title, description, link, image, tags, status, featured = false } = Astro.props;
const statusClass = (status || '').toLowerCase();
---

<a
  href={link}
  class:list={["project-card", `status-${statusClass}`, { featured }]}
  data-tags={(tags || []).join(',')}
  data-project-status={statusClass}
>
  <div class="card-image">
    <Image src={image} alt={title} width={400} height={240} format="webp" quality={80} />
    <div class="status-row">
      <span class={`status-label ${statusClass}`}>{status}</span>
    </div>
  </div>

  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>

    <div class="card-tags">
      {(tags || []).map(tag => (
        <span class={`card-tag ${getTagColorClass(tag)}`}>{tag}</span>
      ))}
    </div>
  </div>
</a>

<style>
  .project-card {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    color: var(--bone);
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .project-card:hover {
    border-color: var(--green-mid);
    transform: translateY(-2px);
    opacity: 1;
  }
  .project-card.featured {
    border-color: var(--bright-pop);
    box-shadow: 0 0 0 1px rgba(232,178,61,0.15), 0 8px 24px rgba(232,178,61,0.06);
  }

  :global(.project-card.is-hidden) { display: none !important; }

  .card-image {
    height: 120px;
    background: linear-gradient(135deg, var(--bg-elevated), var(--bg-void));
    position: relative;
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
  }
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .status-row { position: absolute; top: 0.6rem; right: 0.6rem; }
  .status-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 2px;
    border: 1px solid;
  }
  .status-label.idea { color: var(--gold); border-color: rgba(217,164,65,0.4); background: rgba(217,164,65,0.1); }
  .status-label.in-progress { color: var(--green-bright); border-color: rgba(143,191,92,0.45); background: rgba(143,191,92,0.1); }
  .status-label.completed { color: var(--text-muted); border-color: var(--hairline); background: rgba(0,0,0,0.2); }

  .card-body { padding: 0.95rem 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .card-title { font-family: var(--font-display); font-size: 1rem; font-weight: 600; margin: 0; }
  .card-desc { font-size: 0.82rem; color: var(--text-muted); margin: 0; flex: 1; }

  .card-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.3rem; }
  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 1px 7px;
    border-radius: 2px;
    border: 1px solid;
  }
  .card-tag.tag-green   { color: var(--green-bright); border-color: rgba(143,191,92,0.35); background: rgba(143,191,92,0.08); }
  .card-tag.tag-gold    { color: var(--gold);         border-color: rgba(217,164,65,0.35); background: rgba(217,164,65,0.08); }
  .card-tag.tag-rust    { color: var(--rust);         border-color: rgba(194,84,44,0.35);  background: rgba(194,84,44,0.08); }
  .card-tag.tag-sky     { color: var(--reserved-sky); border-color: rgba(79,163,168,0.35);  background: rgba(79,163,168,0.08); }
  .card-tag.tag-neutral { color: var(--text-faint);   border-color: var(--hairline);        background: rgba(255,255,255,0.02); }
</style>
