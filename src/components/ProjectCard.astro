---
import { Image } from 'astro:assets';
import { getTagColorClass, getDomainLabel } from '@lib/taxonomy';

interface Props {
  title: string;
  description: string;
  link: string;
  image: ImageMetadata;
  tags: string[];
  status: string;
  domains?: string[];
}

const { title, description, link, image, tags, status, domains = [] } = Astro.props;
const statusClass = (status || '').toLowerCase().replace(/\s+/g, '-');
const domainLabels = domains.map(d => getDomainLabel(d));
---

<a
  href={link}
  class:list={["project-card", `status-${statusClass}`]}
  data-tags={(tags || []).join(',')}
  data-domains={(domains || []).join(',')}
  data-project-status={statusClass}
>
  <span class={`status-badge ${statusClass}`}>{status}</span>

  <div class="card-image">
    <Image src={image} alt={title} width={120} height={180} format="webp" quality={80} />
  </div>

  <div class="card-body">
    {domainLabels.length > 0 && (
      <p class="card-domain">{domainLabels.join(' · ')}</p>
    )}
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    <div class="card-tags">
      {(tags || []).map(tag => (
        <span class={`card-tag ${getTagColorClass(tag)}`}>{tag}</span>
      ))}
    </div>
  </div>
</a>

<style>
  .project-card {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    color: var(--bone);
    display: flex;
    flex-direction: row;
    height: 160px;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .project-card:hover {
    border-color: var(--green-mid);
    transform: translateY(-2px);
    opacity: 1;
  }

  /* Status badge — top-right of card */
  .status-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 2px;
    border: 1px solid;
    z-index: 1;
    white-space: nowrap;
  }
  .status-badge.active   { color: var(--reserved-sky); border-color: rgba(79,163,168,0.5);  background: rgba(18,19,21,0.9); }
  .status-badge.resting  { color: var(--gold);         border-color: rgba(217,164,65,0.5);  background: rgba(18,19,21,0.9); }
  .status-badge.shelved  { color: var(--reserved-red); border-color: rgba(194,59,59,0.5);   background: rgba(18,19,21,0.9); }
  .status-badge.idea     { color: var(--text-faint);   border-color: var(--hairline);        background: rgba(18,19,21,0.9); }

  /* Portrait image — fixed 2:3 ratio */
  .card-image {
    width: 107px;
    min-width: 107px;
    flex-shrink: 0;
    background: linear-gradient(160deg, var(--bg-elevated), var(--bg-void));
    border-right: 1px solid var(--hairline);
    overflow: hidden;
  }
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Details — right column */
  .card-body {
    padding: 0.75rem 0.85rem;
    padding-right: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  /* Domain — quiet breadcrumb, above the title */
  .card-domain {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin: 0 0 0.15rem 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Title — the hero, clearly dominant */
  .card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--bone);
    margin: 0 0 0.35rem 0;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Description — secondary, readable, not fighting the title */
  .card-desc {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  /* Tags — bottom, small, colorful but not loud */
  .card-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.4rem;
    overflow: hidden;
    max-height: 1.8rem;
  }
  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 1px 5px;
    border-radius: 2px;
    border: 1px solid var(--hairline);
    color: var(--text-faint);
    background: rgba(255,255,255,0.02);
    white-space: nowrap;
    opacity: 0.85;
  }
  /* tag colours handled by neutral rule above — no per-category colours on cards */
</style>
