---
// src/components/ProjectCard.astro
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  link: string;
  image: ImageMetadata;
  tags: string[];
  status: 'idea' | 'in-progress' | 'completed';
}

const { title, description, link, image, tags, status } = Astro.props;
---

<a href={link} class={`project-card status-${status}`}>
  <div class="card-image-container">
    <Image src={image} alt={title} width={240} height={320} format="webp" quality={80} />
    <span class={`card-status-badge ${status}`}>{status}</span>
  </div>
  
  <div class="card-body-content">
    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>
    
    <div class="card-tags-wrapper">
      {tags.map(tag => <span class="card-tag">{tag}</span>)}
    </div>
  </div>
</a>

<style>
  /* Local styles are now strictly structural layout blocks */
  .project-card {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    overflow: hidden;
    position: relative;
  }

  .card-image-container {
    width: 120px;
    flex-shrink: 0;
    position: relative;
  }

  .card-image-container :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-status-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 0.6rem;
    font-weight: bold;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 0.5px;
  }

  .card-body-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-title { 
    margin: 0 0 0.25rem 0; 
    text-transform: uppercase; 
  }
  
  .card-description { 
    margin: 0 0 0.5rem 0; 
    font-size: 0.85rem; 
  }

  .card-tags-wrapper { 
    display: flex; 
    gap: 0.5rem; 
    flex-wrap: wrap; 
  }
  
  .card-tag { 
    font-size: 0.7rem; 
    padding: 2px 6px; 
  }
</style>