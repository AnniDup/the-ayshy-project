---
// src/components/ProjectCard.astro
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  link: string;
  image: ImageMetadata;
  tags: string[];
}

const { title, description, link, image, tags } = Astro.props;
---

<a href={link} class="card">
  <div class="card-image">
    <!-- Using the Astro Image component for optimization -->
    <Image 
      src={image} 
      alt={title} 
      width={240} 
      height={320} 
      format="webp" 
      quality={80} 
    />
  </div>
  
  <div class="card-content">
    <h3>{title}</h3>
    <p>{description}</p>
    
    <div class="tag-container">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    align-items: stretch;
    background-color: var(--surface-color);
    border: 1px solid var(--accent-sand);
    border-radius: 4px;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s;
  }

  .card:hover {
    border-color: var(--accent-green);
    transform: translateX(5px);
  }

  .card-image {
    width: 120px;
    flex-shrink: 0;
  }

  /* Ensure the Astro Image component fills the container */
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h3 { margin: 0 0 0.25rem 0; color: var(--accent-green); text-transform: uppercase; }
  p { margin: 0 0 0.5rem 0; color: var(--text-muted); font-size: 0.85rem; }

  .tag-container { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tag { 
    font-size: 0.7rem; 
    border: 1px solid var(--accent-green); 
    padding: 2px 6px; 
    color: var(--accent-green);
  }
</style>