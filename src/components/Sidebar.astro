---
// src/components/Sidebar.astro
import { getCollection, type CollectionEntry } from 'astro:content';

const allProjects = await getCollection('projects');

// Group projects by domain for the Workshop dropdown
// FIX: Explicitly type the accumulator and loop element inside the reduce signature
const workshopDomains = allProjects.reduce((
  acc: Record<string, CollectionEntry<'projects'>[]>, 
  project: CollectionEntry<'projects'>
) => {
  const [domain, subProject] = project.id.split('/');
  
  // Skip the root folder index files and incubation items (status: 'idea')
  if (!subProject || subProject === 'index' || subProject === 'index.md' || project.data.status === 'idea') return acc;
  
  if (!acc[domain]) acc[domain] = [];
  acc[domain].push(project);
  return acc;
}, {} as Record<string, CollectionEntry<'projects'>[]>);

// FIX: Type the sort parameters (a, b) so TypeScript knows they are Project Collection entries
Object.keys(workshopDomains).forEach((domain: string) => {
  workshopDomains[domain].sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) => 
    a.data.title.localeCompare(b.data.title)
  );
});

const domainList = Object.entries(workshopDomains) as Array<[string, CollectionEntry<'projects'>[]]>;
---

<aside class="sidebar">
  <div class="sidebar-header">
    <h2>The AyShy Project</h2>
  </div>
  
  <nav>
    <a href="/" class="nav-button">Landing</a>

    <details class="workshop-dropdown" open>
      <summary class="nav-button" onclick="window.location.href='/workshop'; return false;">Workshop</summary>
      <div class="dropdown-content">
  
        {/* FIX: Map over 'domainList' directly so you don't need inline type casting in the HTML */}
        {domainList.map(([domain, projects]) => (
          <div class="domain-level">
            <a href="/soon" class="domain-link">
              {domain.replace('-', ' ')}
            </a>
            
            <div class="project-level">
              {projects.map((p) => (
                <a href="/soon" class="project-link">
                  {p.data.title}
                </a>
              ))}
            </div>
          </div>
        ))}

      </div>
    </details>

    <a href="/incubation" class="nav-button">Incubation</a>
    <a href="/soon" class="nav-button">Vault</a>
    <a href="/soon" class="nav-button">Notebook</a>
  </nav>
</aside>

<style>
  .sidebar {
    background-color: var(--surface-color);
    padding: 1.5rem;
    border-right: 1px solid var(--accent-sand);
    height: 100vh;
    width: 260px;
  }
  .sidebar-header { 
    margin-bottom: 2rem; 
    color: var(--accent-green); 
  }

  nav a.nav-button,
  nav summary.nav-button { 
    display: block; 
    padding: 0.5rem 0; 
    color: var(--text-main); 
    transition: 0.2s;
    cursor: pointer;
    font-weight: bold;
    text-decoration: none;
  }
  nav a.nav-button:hover,
  nav summary.nav-button:hover { 
    color: var(--accent-green); 
    padding-left: 0.5rem; 
  }

  .workshop-dropdown summary {
    list-style: none;
  }
  .workshop-dropdown summary::-webkit-details-marker {
    display: none;
  }
  
  .dropdown-content {
    padding-left: 1rem;
  }

  .domain-level {
    margin-top: 0.75rem;
  }
  .domain-link {
    display: block;
    color: var(--accent-sand);
    text-decoration: none;
    text-transform: capitalize;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.25rem 0;
  }

  .project-level {
    padding-left: 1.25rem; 
  }
  .project-link {
    display: block;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.2rem 0;
  }
  
  .project-link:hover, .domain-link:hover {
    color: var(--accent-green);
  }
</style>